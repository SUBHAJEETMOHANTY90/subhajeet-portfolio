{
  "service": "entity-api",
  "environment": "dev-euwe",
  "namespace": "entity-api",
  "run": {
    "testScript": "load-test.js",
    "vus": 50,
    "rampUp": "2m",
    "duration": "10m"
  },
  "slas": [
    { "metric": "p95_ms", "op": "<", "value": 800, "label": "Client p95 latency (ms)" },
    { "metric": "p99_ms", "op": "<", "value": 1500, "label": "Client p99 latency (ms)" },
    { "metric": "error_rate", "op": "<", "value": 0.01, "label": "Error rate" },
    { "metric": "tps", "op": ">", "value": 200, "label": "Throughput (req/s)" },
    { "metric": "server_p95_ms", "op": "<", "value": 600, "label": "Server-side p95 (ms)" },
    { "metric": "cpu_utilization_pct", "op": "<", "value": 85, "label": "CPU utilisation (%)" },
    { "metric": "pod_restarts", "op": "<=", "value": 0, "label": "Pod restarts" }
  ],
  "serverMetrics": {
    "prometheus": {
      "baseUrl": "",
      "tokenEnv": "PROM_TOKEN"
    },
    "signalfx": {
      "realm": "",
      "tokenEnv": "SFX_TOKEN"
    },
    "traces": {
      "flavor": "tempo",
      "baseUrl": "",
      "tokenEnv": "TEMPO_TOKEN"
    },
    "mock": {
      "metrics": {
        "server_p95_ms": 934.0,
        "server_p99_ms": 2105.0,
        "server_rps": 236.2,
        "server_error_rate": 0.0229,
        "cpu_utilization_pct": 91.4,
        "cpu_throttle_pct": 27.8,
        "memory_working_set_mb": 1740.0,
        "heap_used_pct": 88.3,
        "gc_pause_p95_ms": 186.0,
        "db_p95_ms": 601.0,
        "downstream_p95_ms": 120.0,
        "connection_pool_saturation_pct": 94.0,
        "pod_count_max": 2,
        "pod_restarts": 1
      },
      "topSpans": [
        { "name": "db.query.getEntityByCode", "count": 1820, "avg_ms": 402.1, "p95_ms": 601.0, "max_ms": 1890.0, "total_ms": 731822 },
        { "name": "http.client.pricing-service", "count": 1820, "avg_ms": 96.4, "p95_ms": 120.0, "max_ms": 430.0, "total_ms": 175448 },
        { "name": "cache.lookup", "count": 1820, "avg_ms": 12.2, "p95_ms": 19.0, "max_ms": 88.0, "total_ms": 22204 }
      ]
    }
  },
  "ai": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "apiKeyEnv": "OPENAI_API_KEY"
  }
}
